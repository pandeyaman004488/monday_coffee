   EXTRA ADVANCED — beyond the brief, for a stronger portfolio story
   ========================================================================= */

-- Q11. Customer Repeat-Purchase Rate by City
-- (retention signal — a city with high repeat rate suggests loyal, sticky demand)
WITH order_counts AS (
    SELECT
        ci.city_name,
        s.customer_id,
        COUNT(s.sale_id) AS orders_per_customer
    FROM sales s
    JOIN customers c ON s.customer_id = c.customer_id
    JOIN city ci      ON c.city_id    = ci.city_id
    GROUP BY ci.city_name, s.customer_id
)
SELECT
    city_name,
    COUNT(customer_id)                                              AS total_customers,
    SUM(CASE WHEN orders_per_customer > 1 THEN 1 ELSE 0 END)        AS repeat_customers,
    ROUND(
        100.0 * SUM(CASE WHEN orders_per_customer > 1 THEN 1 ELSE 0 END)
        / COUNT(customer_id), 2
    ) AS repeat_customer_pct
FROM order_counts
GROUP BY city_name
ORDER BY repeat_customer_pct DESC;


-- Q12. Product Quality Signal — average customer rating by city
-- (flags cities where the product experience is landing well, not just volume)
SELECT
    ci.city_name,
    ROUND(AVG(s.rating), 2) AS avg_rating,
    COUNT(s.sale_id)        AS total_orders
FROM sales s
JOIN customers c ON s.customer_id = c.customer_id
JOIN city ci      ON c.city_id    = ci.city_id
GROUP BY ci.city_name
ORDER BY avg_rating DESC;


-- Q13. Best-Selling Product by Revenue (not just order count) — overall
SELECT
    p.product_name,
    COUNT(s.sale_id)      AS total_orders,
    SUM(s.total)           AS total_revenue,
    ROUND(SUM(s.total) / COUNT(s.sale_id), 2) AS avg_order_value
FROM products p
JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_name
ORDER BY total_revenue DESC;


-- Q14. Cumulative (running total) Revenue by Month — company-wide trend
WITH monthly_totals AS (
    SELECT
        DATE_TRUNC('month', sale_date) AS sale_month,
        SUM(total) AS monthly_revenue
    FROM sales
    GROUP BY DATE_TRUNC('month', sale_date)
)
SELECT
    sale_month,
    monthly_revenue,
    SUM(monthly_revenue) OVER (ORDER BY sale_month) AS running_total_revenue
FROM monthly_totals
ORDER BY sale_month;


-- Q15. Weighted Expansion Score — combine consumer size, revenue, and rent efficiency
-- into a single rankable score to make the final city recommendation less subjective.
-- Weights: 40% consumer base, 40% total revenue, 20% rent efficiency (inverse of avg rent/customer)
WITH city_metrics AS (
    SELECT
        ci.city_name,
        ROUND((ci.population * 0.25) / 1000000, 2)              AS consumers_millions,
        SUM(s.total)                                             AS total_revenue,
        COUNT(DISTINCT s.customer_id)                            AS total_customers,
        ROUND(ci.estimated_rent / COUNT(DISTINCT s.customer_id), 2) AS avg_rent_per_customer
    FROM sales s
    JOIN customers c ON s.customer_id = c.customer_id
    JOIN city ci      ON c.city_id    = ci.city_id
    GROUP BY ci.city_name, ci.estimated_rent, ci.population
),
normalized AS (
    SELECT
        city_name,
        consumers_millions / (SELECT MAX(consumers_millions) FROM city_metrics) AS consumer_score,
        total_revenue      / (SELECT MAX(total_revenue)      FROM city_metrics) AS revenue_score,
        1 - (avg_rent_per_customer / (SELECT MAX(avg_rent_per_customer) FROM city_metrics)) AS rent_efficiency_score
    FROM city_metrics
)
SELECT
    city_name,
    ROUND(
        (0.4 * consumer_score) + (0.4 * revenue_score) + (0.2 * rent_efficiency_score),
        3
    ) AS expansion_score
FROM normalized
ORDER BY expansion_score DESC
LIMIT 3;


